[Unit]
Description=Restaurant lead bot (Telegram)
# network-online, а не network: боту при старте нужен рабочий интернет (GitHub, Telegram)
After=network-online.target
Wants=network-online.target
# Ограничение перезапусков задаётся в [Unit]: в [Service] современный systemd его не понимает
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
# Рабочая папка важна: база и кэш переводов лежат рядом с кодом по относительным путям
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python main.py
Environment=PYTHONUNBUFFERED=1
# Бот падает разве что от обрыва сети — поднимаем обратно, но без бесконечного цикла перезапусков
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
